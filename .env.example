# Contact form (src/app/api/contact/route.ts) — copy to .env.local and fill in
RESEND_API_KEY=
# Where contact messages are delivered
CONTACT_TO_EMAIL=
# Optional. Without a verified domain in Resend, keep the default sender,
# which can only deliver to the email you signed up to Resend with.
# CONTACT_FROM_EMAIL="Portfolio <contact@yourdomain.com>"
